{
  "name": "gitline",
  "version": "0.1.2",
  "description": "Show Git blame (time/author/message) at end of the current line, format configurable. 行尾 Git 归属：时间、提交人、提交消息，格式可配置。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "blame"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  }
}
